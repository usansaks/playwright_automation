{
    "loginPage":{
        "usernameInput":"input[name='user-name']",
        "passwordInput":"input[id='password']",
        "loginButton":"input[class='submit-button btn_action']",
        "errorMessage":"h3[data-test='error']"
    },
    "navigatePage":{
        "validatePage": "span[class='title']"
    },
    "productsPage":{
        "productName": ".inventory_item_name",
        "productPrice": "div[class='inventory_item_price']",
        "addtoCart": "button[id='add-to-cart']",
        "backtoProduct": "button[id='back-to-products']",
        "cartIcon": "a[class='shopping_cart_link']",
        "toggleBtn": "button[id='react-burger-menu-btn']",
        "logOut": "a[id='logout_sidebar_link']"
    },
    "cartPage": {
        "cartQuantity": "div[class='cart_quantity']",
        "removeButton": "'button', { hasText: 'Remove' }",
        "checkoutButton": "('button[name='{Checkout}']"
    },
    "checkoutPage": {
        "userFirstname": "input[placeholder='First Name']",
        "userLastname": "input[placeholder='Last Name']",
        "userZip": "input[placeholder='Zip/Postal Code']",
        "continueButton": "input[name='continue']",
        "finishButton": "button[name='finish']"
    }
}